+  box(root, [2.3, 0.16, 2], [6.5, 2.28, 5], roof);
+  [[-6, 6.8, 7.5], [6, 6.8, 7.5]].forEach(([x, z, length]) => box(root, [length, 2.1, 0.12], [x, 1.05, z], steel));
