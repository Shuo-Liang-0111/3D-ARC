@@ -0,0 +1,55 @@
+import { BOOK_COLORS, LEVEL as BASE_LEVEL } from "./level.js";
+
+export const REVISION = "shared-library-v1";
+export const ASSET_ROOT = "/local-assets/cardinal/rf02/models/runtime/" + REVISION;
+export const SHELF_BOOKS = Object.freeze(Object.fromEntries(BOOK_COLORS.map((color) => {
+  const shelf = BASE_LEVEL.shelves[color];
+  const source = color === "black"
+    ? { x: -0.56, z: -6.43, y: 1.16 }
+    : { x: color === "red" ? -10.43 : 10.43, z: -1.65, y: 1.16 };
+  const landing = color === "black"
+    ? { x: -0.56, z: -5.30, y: 0.012 }
+    : { x: color === "red" ? -9.30 : 9.30, z: -1.65, y: 0.012 };
+  return [color, Object.freeze({ ...source, landing, rotation: shelf.rotation })];
+})));
+
+export const BOOKS = Object.freeze([
+  ...BOOK_COLORS.map((color) => Object.freeze({
+    id: color, color, ...BASE_LEVEL.books[color], y: 0.78, support: "return-table", location: "table",
+  })),
+  Object.freeze({ id: "red-reading", color: "red", x: -5.82, z: 2.35, y: 0.75, support: "west-reading-zone", location: "table" }),
+  Object.freeze({ id: "black-reading", color: "black", x: 6.12, z: 2.35, y: 0.75, support: "east-reading-zone", location: "table" }),
+  Object.freeze({ id: "white-cart", color: "white", x: 2.45, z: 4.55, y: 0.76, support: "return-cart", location: "table" }),
+  ...BOOK_COLORS.map((color) => Object.freeze({
+    id: "shelf-" + color, color, ...SHELF_BOOKS[color], support: color + "-target-shelf", location: "shelved", background: true,
+  })),
+]);
+
+export function seriesLevel(id) {
+  const dynamic = id === "rf02-3";
+  return Object.freeze({
+    ...BASE_LEVEL,
+    id,
+    title: dynamic ? "Archive Recovery" : "Reading Room Returns",
+    revision: REVISION,
+    dynamic,
+    interactionRange: 1.55,
+    progress: Object.freeze({
+      initial: 100, maximum: 100,
+      movementDrainPerMeter: dynamic ? 0.80 : 0.68,
+      blockedDrainPerSecond: dynamic ? 1.25 : 1.05,
+      errorCost: dynamic ? 5 : 3,
+      repeatCost: 1,
+      pickupReward: 1,
+      correctBookReward: 2,
+    }),
+    fallDuration: 0.95,
+    fallAfterReturns: 2,
+  });
+}
+
+export function shelfPose(color, id) {
+  const source = SHELF_BOOKS[color];
+  const slot = id.startsWith("shelf-") ? 0 : id === color ? 0.45 : 0.90;
+  return { x: source.x + (color === "black" ? slot : 0), y: source.y, z: source.z + (color === "black" ? 0 : slot), rotation: source.rotation };
+}
diff --git a/game/levels/rf02/series-engine.js b/game/levels/rf02/series-engine.js
new file mode 100644
--- /dev/null
+++ b/game/levels/rf02/series-engine.js
@@ -0,0 +1,188 @@
+import { applyRobotMovement } from "../../movement.js";
+import { BOOK_COLORS } from "./level.js";
+import { BOOKS, SHELF_BOOKS, shelfPose, seriesLevel } from "./series-layout.js";
+
+const EPSILON = 1e-7;
+const distance = (left, right) => Math.hypot(left.x - right.x, left.z - right.z);
+const clone = (state) => ({
+  ...state, player: { ...state.player },
+  books: Object.fromEntries(Object.entries(state.books).map(([id, book]) => [id, { ...book }])),
+  rewardedActions: { ...state.rewardedActions }, incident: { ...state.incident },
+});
+
+function overlaps(x, z, radius, rect) {
+  const nearX = Math.max(rect.minX, Math.min(x, rect.maxX));
+  const nearZ = Math.max(rect.minZ, Math.min(z, rect.maxZ));
+  return (x - nearX) ** 2 + (z - nearZ) ** 2 < radius ** 2;
+}
+
+export function createArchiveEngine(id) {
+  const LEVEL = seriesLevel(id);
+
+  function createInitialState(options = {}) {
+    const supplied = typeof options.random === "function" ? options.random() : Math.random();
+    const sample = Number.isFinite(supplied) ? Math.max(0, Math.min(0.999999, supplied)) : 0;
+    const color = BOOK_COLORS[Math.floor(sample * BOOK_COLORS.length)];
+    return {
+      player: { ...LEVEL.playerStart },
+      books: Object.fromEntries(BOOKS.map((book) => [book.id, { ...book }])),
+      carriedBook: null, carriedItem: null,
+      complete: false, failed: false, terminalOpen: false,
+      progress: LEVEL.progress.initial, minimumProgress: LEVEL.progress.initial,
+      rewardedActions: {}, returnedCount: 0,
+      incident: { color, bookId: "shelf-" + color, phase: LEVEL.dynamic ? "waiting" : "disabled", elapsed: 0 },
+      motion: "idle", elapsed: 0, distanceTravelled: 0, blockedTime: 0,
+      interactions: 0, lastEvent: "library_entered", revision: LEVEL.revision,
+    };
+  }
+
+  function isWalkable(_state, x, z, radius = LEVEL.playerRadius) {
+    const bounds = LEVEL.bounds;
+    if (![x, z, radius].every(Number.isFinite)) return false;
+    if (x - radius < bounds.minX || x + radius > bounds.maxX || z - radius < bounds.minZ || z + radius > bounds.maxZ) return false;
+    return !LEVEL.staticColliders.some((rect) => overlaps(x, z, radius, rect));
+  }
+
+  function settle(before, next, cost = 0, rewardKey = null, reward = 0) {
+    if (before.progress <= cost + EPSILON && cost > 0) {
+      const failed = clone(before);
+      failed.progress = 0;
+      failed.minimumProgress = 0;
+      failed.failed = true;
+      failed.motion = "idle";
+      failed.lastEvent = "progress_depleted";
+      failed.interactions = next.interactions;
+      return failed;
+    }
+    next.progress = before.progress - cost;
+    if (rewardKey && !before.rewardedActions[rewardKey]) {
+      next.rewardedActions[rewardKey] = true;
+      next.progress = Math.min(LEVEL.progress.maximum, next.progress + reward);
+    }
+    next.minimumProgress = Math.min(before.minimumProgress, next.progress);
+    return next;
+  }
+
+  function updateMovement(state, input = {}, deltaSeconds = 0) {
+    if (state.complete || state.failed) return clone(state);
+    const next = clone(state);
+    const dt = Number.isFinite(deltaSeconds) ? Math.min(0.05, Math.max(0, deltaSeconds)) : 0;
+    const movement = applyRobotMovement(next, state, input, dt, LEVEL, isWalkable);
+    const travelled = distance(next.player, state.player);
+    next.elapsed += dt;
+    next.distanceTravelled += travelled;
+    const blocked = movement.translating && travelled < EPSILON;
+    next.blockedTime += blocked ? dt : 0;
+    next.motion = movement.motionTurning ? "turning" : travelled > EPSILON ? "moving" : state.carriedBook ? "carrying" : "idle";
+    const cost = travelled * LEVEL.progress.movementDrainPerMeter + (blocked ? dt * LEVEL.progress.blockedDrainPerSecond : 0);
+    return settle(state, next, cost);
+  }
+
+  function reachable(state, point, ignoredCollider) {
+    const steps = Math.max(1, Math.ceil(distance(state.player, point) / 0.08));
+    for (let index = 1; index < steps; index += 1) {
+      const blend = index / steps;
+      const x = state.player.x + (point.x - state.player.x) * blend;
+      const z = state.player.z + (point.z - state.player.z) * blend;
+      if (LEVEL.staticColliders.some((rect) => rect.id !== ignoredCollider && x > rect.minX && x < rect.maxX && z > rect.minZ && z < rect.maxZ)) return false;
+    }
+    return true;
+  }
+
+  function getInteraction(state) {
+    if (state.complete || state.failed) return null;
+    const candidates = [];
+    if (state.carriedBook) {
+      for (const color of BOOK_COLORS) {
+        const shelf = LEVEL.shelves[color];
+        if (reachable(state, shelf, color + "-target-shelf")) candidates.push({ type: "shelf", color, distance: distance(state.player, shelf) });
+      }
+    } else {
+      for (const [bookId, book] of Object.entries(state.books)) {
+        const active = !book.background || (bookId === state.incident.bookId && state.incident.phase === "ground");
+        if (active && ["table", "ground"].includes(book.location) && reachable(state, book, book.support)) {
+          candidates.push({ type: "book", bookId, color: book.color, distance: distance(state.player, book) });
+        }
+      }
+    }
+    const nearest = candidates.filter((candidate) => candidate.distance <= LEVEL.interactionRange).sort((left, right) => left.distance - right.distance)[0];
+    if (nearest) return nearest;
+    return state.carriedBook ? { type: "drop", bookId: state.carriedBook } : null;
+  }
+
+  function interact(state) {
+    if (state.complete || state.failed) return clone(state);
+    const next = clone(state);
+    next.interactions += 1;
+    const action = getInteraction(state);
+    if (!action) {
+      next.lastEvent = "empty_interaction";
+      return settle(state, next, LEVEL.progress.errorCost);
+    }
+    if (action.type === "book") {
+      const book = next.books[action.bookId];
+      const rewardKey = "pickup:" + action.bookId;
+      book.location = "carried";
+      next.carriedBook = action.bookId;
+      next.carriedItem = action.bookId;
+      next.motion = "carrying";
+      next.lastEvent = "archive_book_collected";
+      return settle(state, next, state.rewardedActions[rewardKey] ? LEVEL.progress.repeatCost : 0, rewardKey, LEVEL.progress.pickupReward);
+    }
+    if (action.type === "drop") {
+      const book = next.books[state.carriedBook];
+      const point = {
+        x: state.player.x + Math.sin(state.player.yaw) * 0.58,
+        z: state.player.z + Math.cos(state.player.yaw) * 0.58,
+      };
+      if (!isWalkable(state, point.x, point.z, 0.15)) {
+        next.lastEvent = "blocked_drop";
+        return settle(state, next, LEVEL.progress.errorCost);
+      }
+      Object.assign(book, point, { y: 0.012, location: "ground", support: null });
+      next.carriedBook = null;
+      next.carriedItem = null;
+      next.motion = "idle";
+      next.lastEvent = "archive_book_dropped";
+      return settle(state, next, LEVEL.progress.repeatCost);
+    }
+    const book = next.books[state.carriedBook];
+    if (book.color !== action.color) {
+      next.lastEvent = "wrong_shelf";
+      return settle(state, next, LEVEL.progress.errorCost);
+    }
+    const bookId = state.carriedBook;
+    Object.assign(book, shelfPose(book.color, bookId), { location: "shelved" });
+    next.carriedBook = null;
+    next.carriedItem = null;
+    next.motion = "idle";
+    next.lastEvent = "archive_book_shelved";
+    if (book.background) next.incident.phase = "restored";
+    else next.returnedCount += 1;
+    if (LEVEL.dynamic && next.incident.phase === "waiting" && next.returnedCount >= LEVEL.fallAfterReturns) {
+      next.incident.phase = "falling";
+      next.incident.elapsed = 0;
+      next.books[next.incident.bookId].location = "falling";
+    }
+    next.complete = next.returnedCount === 6 && (!LEVEL.dynamic || next.incident.phase === "restored");
+    if (next.complete) next.lastEvent = "archive_complete";
+    return settle(state, next, 0, "return:" + bookId, LEVEL.progress.correctBookReward);
+  }
+
+  function updateEnvironment(state, deltaSeconds = 0) {
+    if (state.complete || state.failed || state.incident.phase !== "falling") return state;
+    const next = clone(state);
+    next.incident.elapsed = Math.min(LEVEL.fallDuration, state.incident.elapsed + Math.min(0.05, Math.max(0, Number.isFinite(deltaSeconds) ? deltaSeconds : 0)));
+    if (next.incident.elapsed >= LEVEL.fallDuration - EPSILON) {
+      next.incident.phase = "ground";
+      Object.assign(next.books[next.incident.bookId], SHELF_BOOKS[next.incident.color].landing, { location: "ground", support: null });
+    }
+    return next;
+  }
+
+  function getObjective(state) {
+    return { step: state.complete ? 1 : 0, title: state.failed ? "任务失败" : state.complete ? "馆藏整理完成" : LEVEL.dynamic ? "完成六本书归架，并将掉落的馆藏书归位" : "找到并归还馆内六本待归架书籍", detail: "" };
+  }
+
+  return { LEVEL, createInitialState, isWalkable, getInteraction, interact, updateMovement, updateEnvironment, getObjective, closeTerminal: clone };
+}
diff --git a/game/levels/rf02/series-scene.js b/game/levels/rf02/series-scene.js
