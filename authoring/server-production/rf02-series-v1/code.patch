+++ b/game/levels/rf02/series-scene.js
@@ -0,0 +1,83 @@
+import * as THREE from "three";
+import { GLTFLoader } from "three/addons/loaders/GLTFLoader.js";
+import { createLibraryScene } from "./scene.js";
+import { LEVEL } from "./level.js";
+import { ASSET_ROOT, BOOKS, SHELF_BOOKS, REVISION, shelfPose } from "./series-layout.js";
+
+export function createArchiveScene() {
+  const world = createLibraryScene();
+  world.revision = REVISION;
+  world.archiveRoots = { ...world.bookRoots };
+  world.lastIncidentPhase = "waiting";
+  const originalReady = world.assetReady;
+  const collisionReady = new Promise((resolve) => new GLTFLoader().load(
+    ASSET_ROOT + "/library-collision.glb",
+    (gltf) => {
+      gltf.scene.name = "rf02-authoritative-collision";
+      gltf.scene.visible = false;
+      world.scene.add(gltf.scene);
+      const boxes = new Map();
+      gltf.scene.updateMatrixWorld(true);
+      gltf.scene.traverse((node) => {
+        if (node.userData.collision && node.isMesh) boxes.set(node.name, new THREE.Box3().setFromObject(node));
+      });
+      const valid = LEVEL.staticColliders.every((rect) => {
+        const bounds = boxes.get("COLLIDER_" + rect.id);
+        return bounds && Math.abs(bounds.min.x - rect.minX) < 0.001 && Math.abs(bounds.max.x - rect.maxX) < 0.001
+          && Math.abs(bounds.min.z - rect.minZ) < 0.001 && Math.abs(bounds.max.z - rect.maxZ) < 0.001;
+      });
+      resolve({ loaded: valid, name: "shared-library-collision", url: ASSET_ROOT + "/library-collision.glb" });
+    },
+    undefined,
+    () => resolve({ loaded: false, name: "shared-library-collision" }),
+  ));
+  world.collisionReady = collisionReady;
+  world.assetReady = Promise.all([originalReady, collisionReady]).then(([results, collision]) => {
+    for (const book of BOOKS.filter((entry) => !world.archiveRoots[entry.id])) {
+      const root = new THREE.Group();
+      root.name = "archive-book-" + book.id;
+      const source = world.assetRoots.books[book.color];
+      root.add(source.clone(true));
+      world.scene.add(root);
+      world.archiveRoots[book.id] = root;
+    }
+    return [...results, collision];
+  });
+  return world;
+}
+
+function poseBook(root, book, incident) {
+  root.visible = book.location !== "carried";
+  if (!root.visible) return;
+  let pose = book.location === "shelved" ? shelfPose(book.color, book.id) : book;
+  let tilt = 0;
+  if (book.location === "falling") {
+    const source = SHELF_BOOKS[book.color];
+    const progress = Math.min(1, incident.elapsed / 0.95);
+    const travel = Math.min(1, progress / 0.8);
+    const falling = Math.max(0, (progress - 0.24) / 0.76);
+    pose = {
+      x: source.x + (source.landing.x - source.x) * travel,
+      z: source.z + (source.landing.z - source.z) * travel,
+      y: Math.max(0.012, source.y * (1 - falling * falling)),
+      rotation: source.rotation,
+    };
+    tilt = Math.sin(Math.PI * falling) * 0.65;
+  }
+  root.position.set(pose.x, pose.y ?? 0.78, pose.z);
+  root.rotation.set(tilt, pose.rotation ?? 0, 0);
+}
+
+export function syncArchiveVisuals(world, state) {
+  for (const definition of BOOKS) {
+    const root = world.archiveRoots[definition.id];
+    if (!root) continue;
+    const stateBook = state.books[definition.id];
+    const book = stateBook ? { ...definition, ...stateBook } : definition;
+    poseBook(root, book, state.incident);
+  }
+  if (state.incident?.phase === "ground" && world.lastIncidentPhase === "falling") {
+    world.bookImpact?.play().catch(() => {});
+  }
+  world.lastIncidentPhase = state.incident?.phase ?? "waiting";
+}
