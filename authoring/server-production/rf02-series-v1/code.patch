+import { createArchiveEngine } from "./series-engine.js";
+import { createArchiveScene, syncArchiveVisuals } from "./series-scene.js";
+import { createLibraryCargoModel, setLibraryCargoModel } from "./scene.js";
+import { ASSET_ROOT } from "./series-layout.js";
+
+export function createArchiveRuntime(id) {
+  const engine = createArchiveEngine(id);
+  const dynamic = engine.LEVEL.dynamic;
+  return {
+    ...engine,
+    ui: Object.freeze({
+      id, brand: "PUBLIC LIBRARY ARCHIVES", unit: id.toUpperCase() + " · MUNICIPAL LIBRARY",
+      systemLabel: "ARCHIVES", cargoLabel: "CARGO", gateLabel: "COLLECTION",
+      startKicker: "LEVEL " + id.toUpperCase() + " / PUBLIC LIBRARY",
+      startTitle: dynamic ? "ARCHIVE<br />RECOVERY" : "READING ROOM<br />RETURNS",
+      startCopy: dynamic ? "完成六本书归架，并将掉落的馆藏书归位" : "找到并归还馆内六本待归架书籍",
+      completeKicker: "ARCHIVE RESTORED", completeTitle: "館藏整理完成",
+      completeCopy: dynamic ? "六本待归架书与掉落的馆藏书均已正确归位。" : "六本待归架书均已回到对应馆藏区。",
+      terminalHeading: "CATALOG TERMINAL",
+    }),
+    camera: Object.freeze({ position: [0, 34, 11], lookAt: [0, 0.45, 0], fov: 34 }),
+    audio: Object.freeze({ assets: {}, eventSounds: {}, volume: {} }),
+    eventMessages: Object.freeze({}),
+    createScene() {
+      const world = createArchiveScene();
+      if (dynamic) {
+        world.bookImpact = new Audio(ASSET_ROOT + "/book-impact.mp3");
+        world.bookImpact.volume = 0.65;
+        world.bookImpact.preload = "auto";
+        const original = world.assetReady;
+        world.assetReady = Promise.all([original, fetch(ASSET_ROOT + "/book-impact.mp3").then((response) => response.ok).catch(() => false)])
+          .then(([results, loaded]) => [...results, { loaded, name: "book-impact-audio", url: ASSET_ROOT + "/book-impact.mp3" }]);
+      }
+      return world;
+    },
+    syncVisuals: syncArchiveVisuals,
+    createCargoModel: createLibraryCargoModel,
+    syncRobotCargo(robot, state) {
+      if (state.carriedBook) setLibraryCargoModel(robot.userData.rackPayload, state.books[state.carriedBook].color);
+    },
+    isCarrying: (state) => Boolean(state.carriedBook),
+    getTelemetry(state) {
+      return { system: state.complete ? "RESTORED" : "ACTIVE", systemOnline: state.complete, cargo: state.carriedBook ? state.books[state.carriedBook].color.toUpperCase() + " BOOK" : "EMPTY", gate: state.complete ? "COMPLETE" : "IN PROGRESS" };
+    },
+    getProgressSteps: () => [],
+    getTerminal: () => ({ title: "目录终端", copy: "", rows: [] }),
+    getSoundPosition: (_before, state) => state.player,
+    getDebugState: (state) => ({ revision: state.revision, returnedCount: state.returnedCount, incident: state.incident, carriedBook: state.carriedBook, minimumProgress: state.minimumProgress }),
+  };
+}
