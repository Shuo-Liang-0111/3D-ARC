+    shader.fragmentShader = shader.fragmentShader.replace("#include <opaque_fragment>",
+      "if (workshopCutaway > 0.5 && cameraPosition.y > 6.0 && workshopHeight > 1.6) discard;\n#include <opaque_fragment>");
+  };
