+      next.progress = Math.min(100, next.progress + reward);
+    }
+    return next;
+  }
+
+  function chairBesideTable(chair) {
+    const table = fixed.find((object) => object.id === (chair.id.startsWith("west") ? "west-reading-zone" : "east-reading-zone"));
+    const extentX = Math.abs(Math.cos(chair.yaw)) * chair.halfX + Math.abs(Math.sin(chair.yaw)) * chair.halfZ;
+    const extentZ = Math.abs(Math.sin(chair.yaw)) * chair.halfX + Math.abs(Math.cos(chair.yaw)) * chair.halfZ;
+    const gapX = Math.max(0, Math.abs(chair.x - table.x) - table.halfX - extentX);
+    const gapZ = Math.max(0, Math.abs(chair.z - table.z) - table.halfZ - extentZ);
+    return Math.hypot(gapX, gapZ) <= 0.38 && !rectanglesOverlap(chair, table);
