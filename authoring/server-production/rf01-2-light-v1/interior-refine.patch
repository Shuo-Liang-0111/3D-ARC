+function addControl(parent, name, position, label, emissive) {
+  const plate = new THREE.MeshStandardMaterial({ color: 0xc4c6ba, roughness: .5, metalness: .3, envMapIntensity: .02 });
+  const root = new THREE.Group();
+  root.name = name;
+  root.position.set(...position);
+  parent.add(root);
+  makeBox(root, name + "-box", [.28, .42, .085], [0, 0, 0], plate);
+  const buttonMaterial = new THREE.MeshStandardMaterial({ color: 0x317845, emissive: 0x1d6638, emissiveIntensity: emissive, roughness: .4 });
+  const button = makeBox(root, name + "-button", [.12, .13, .04], [0, -.07, .06], buttonMaterial);
+  const canvas = document.createElement("canvas");
+  canvas.width = 256;
+  canvas.height = 80;
+  const context = canvas.getContext("2d");
+  context.fillStyle = "#e6e7d9";
+  context.fillRect(0, 0, 256, 80);
+  context.fillStyle = "#15251d";
+  context.font = "bold 35px sans-serif";
+  context.textAlign = "center";
+  context.fillText(label, 128, 53);
+  const labelMaterial = new THREE.MeshStandardMaterial({ map: new THREE.CanvasTexture(canvas), roughness: .7, emissive: 0x223322, emissiveIntensity: .2 });
+  makeBox(root, name + "-label", [.245, .08, .01], [0, .105, .049], labelMaterial);
+  return button;
+}
+
+function addCutaway(material, uniform) {
+  const previousCompile = material.onBeforeCompile;
+  const previousKey = material.customProgramCacheKey();
+  material.onBeforeCompile = shader => {
+    previousCompile.call(material, shader);
+    shader.uniforms.workshopCutaway = uniform;
+    shader.vertexShader = "varying float workshopHeight;\n" + shader.vertexShader;
+    shader.vertexShader = shader.vertexShader.replace("#include <project_vertex>",
+      "#include <project_vertex>\nworkshopHeight = (modelMatrix * vec4(transformed, 1.0)).y;");
+    shader.fragmentShader = "uniform float workshopCutaway;\nvarying float workshopHeight;\n" + shader.fragmentShader;
+    shader.fragmentShader = shader.fragmentShader.replace("#include <opaque_fragment>",
+      "if (workshopCutaway > 0.5 && cameraPosition.y > 6.0 && workshopHeight > 1.6) discard;\n#include <opaque_fragment>");
+  };
+  material.customProgramCacheKey = () => previousKey + "-workshop-cutaway-v1";
+  material.needsUpdate = true;
+}
+
+export function installWorkshopInterior(world) {
+  const workshop = world.productionAssets.getObjectByName("rf01-cardinal-workshop-meter-fitted");
+  if (!workshop) throw new Error("RF-01 workshop production asset missing");
+  const root = new THREE.Group();
+  root.name = "rf01-shared-workshop-interior";
+  world.scene.add(root);
+  const shutter = new THREE.Group();
+  shutter.name = "rf01-workshop-rolling-shutter";
+  root.add(shutter);
+  const originals = [];
+  workshop.traverse(object => { if (object.isMesh) originals.push(object); });
+  for (const original of originals) {
+    const separated = separateShutter(original);
+    root.add(separated.shell);
+    shutter.add(separated.door);
+    original.visible = false;
+  }
+  const wallMaterial = roomMaterial(0x858e91, world.surfaces.cladding.map);
+  const floorMaterial = roomMaterial(0x969b95, world.surfaces.concrete.map);
+  floorMaterial.normalMap = world.surfaces.concrete.normalMap;
+  floorMaterial.roughnessMap = world.surfaces.concrete.roughnessMap;
+  makeBox(root, "workshop-floor", [9.2, .04, 4.55], [0, .015, -4.175], floorMaterial);
+  makeBox(root, "workshop-ceiling", [9.2, .08, 4.55], [0, 4.0, -4.175], wallMaterial);
+  makeBox(root, "workshop-back-lining", [9.2, 3.95, .08], [0, 2, -6.5], wallMaterial);
+  makeBox(root, "workshop-west-lining", [.08, 3.95, 4.55], [-4.6, 2, -4.175], wallMaterial);
+  makeBox(root, "workshop-east-lining", [.08, 3.95, 4.55], [4.6, 2, -4.175], wallMaterial);
+  makeBox(root, "workshop-front-left-lining", [4.5, 3.95, .08], [-2.65, 2, -1.99], wallMaterial);
+  makeBox(root, "workshop-front-right-lining", [1.15, 3.95, .08], [4.32, 2, -1.99], wallMaterial);
+  makeBox(root, "workshop-door-lintel-lining", [4.11, 1.57, .12], [1.675, 3.19, -1.99], wallMaterial);
+  const steel = new THREE.MeshStandardMaterial({ color: 0x5e686a, metalness: .7, roughness: .45 });
+  [-.43, 3.78].forEach(position => makeBox(root, "shutter-guide", [.10, 2.45, .20], [position, 1.225, -1.27], steel));
+  makeBox(root, "shutter-roller-housing", [4.34, .18, .27], [1.675, 2.46, -1.30], steel);
+  const outsideButton = addControl(root, "workshop-door-control",
+    [WORKSHOP.doorControl.x, WORKSHOP.doorControl.y, WORKSHOP.doorControl.z], "OPEN", .7);
+  const insideButton = addControl(root, "workshop-light-switch",
+    [WORKSHOP.lightSwitch.x, WORKSHOP.lightSwitch.y, WORKSHOP.lightSwitch.z], "LIGHT", .8);
+  makeBox(root, "workshop-switch-conduit", [.035, 2.68, .035], [3.8, 2.6, -6.41], steel);
+  const fixtures = world.productionAssets.children.filter(child => {
+    let found = false;
+    child.traverse(object => { if (object.name === "rf01-cardinal-lightFixture") found = true; });
+    return found;
+  });
+  const bulbs = [];
+  const lights = [];
+  fixtures.forEach((fixture, index) => {
+    const position = WORKSHOP.lampPositions[index];
+    if (!position) return;
+    fixture.position.set(...position);
+    fixture.traverse(object => {
+      if (!object.isMesh) return;
+      object.material = object.material.clone();
+      object.material.emissiveIntensity = 0;
+    });
+    const glow = new THREE.MeshStandardMaterial({ color: 0xcdd5d2, emissive: 0xffeed3, emissiveIntensity: 0, roughness: .5 });
+    bulbs.push(glow);
+    makeBox(root, "workshop-light-diffuser-" + index, [1.5, .025, .12], [position[0], 3.65, position[2]], glow);
+    const light = new THREE.PointLight(0xffeedc, 0, 9, 2);
+    light.position.set(position[0], 3.4, position[2]);
+    light.castShadow = true;
+    light.shadow.mapSize.set(512, 512);
+    light.shadow.bias = -.001;
+    root.add(light);
+    lights.push(light);
+    makeBox(root, "workshop-light-bracket-" + index, [.05, .24, .05], [position[0], 3.86, position[2]], steel);
+  });
+  if (fixtures.length !== 3) throw new Error("RF-01 workshop requires all three existing light fixtures");
+  const cutaway = { value: 0 };
+  const materials = new Set();
+  [root, ...fixtures].forEach(group => group.traverse(object => {
+    if (!object.isMesh) return;
+    const entries = Array.isArray(object.material) ? object.material : [object.material];
+    entries.forEach(material => materials.add(material));
+  }));
+  materials.forEach(material => addCutaway(material, cutaway));
+  const result = { root, shutter, lights, bulbs, outsideButton, insideButton, fixtures, cutaway, revision: "workshop-light-v1" };
+  setWorkshopLighting(result, false);
+  syncWorkshopShutter(result, 0);
+  return result;
+}
+
+export function syncWorkshopShutter(workshop, lift) {
+  const height = Math.max(0, Math.min(WORKSHOP.height, lift));
+  workshop.shutter.position.y = height;
+  workshop.shutter.scale.y = Math.max(.012, (WORKSHOP.height - height) / WORKSHOP.height);
+  workshop.outsideButton.material.emissiveIntensity = height >= WORKSHOP.clearance ? 1.3 : .45;
+}
+
+export function setWorkshopLighting(workshop, enabled) {
+  workshop.lights.forEach(light => { light.intensity = enabled ? 85 : 0; });
+  workshop.bulbs.forEach(material => { material.emissiveIntensity = enabled ? 5 : 0; });
+  workshop.insideButton.material.emissiveIntensity = enabled ? 1.3 : .8;
+}
