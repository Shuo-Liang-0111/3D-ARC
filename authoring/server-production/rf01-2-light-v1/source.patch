@@ -0,0 +1,141 @@
+import { applyRobotMovement } from "../../movement.js";
+import { LEVEL, WORKSHOP } from "./level.js";
+import { DOOR_COLLIDER } from "../../level.js";
+export { LEVEL };
+
+export function createInitialState() {
+  return {
+    player: { ...LEVEL.playerStart }, battery: { location: "ground", ...LEVEL.batteryStart },
+    powered: false, doorOpen: false, terminalOpen: false,
+    shutterRequested: false, shutterLift: 0, enteredWorkshop: false, lightsOn: false,
+    complete: false, failed: false, progress: LEVEL.progress.initial, minimumReserve: LEVEL.progress.initial,
+    rewardedMilestones: {}, motion: "idle", elapsed: 0, interactions: 0, distanceMoved: 0,
+    lastEvent: "workshop_dark",
+  };
+}
+
+export function cloneState(state) {
+  return { ...state, player: { ...state.player }, battery: { ...state.battery }, rewardedMilestones: { ...state.rewardedMilestones } };
+}
+
+function overlaps(point, rect) {
+  const nearX = Math.max(rect.minX, Math.min(point.x, rect.maxX));
+  const nearZ = Math.max(rect.minZ, Math.min(point.z, rect.maxZ));
+  return (point.x - nearX) ** 2 + (point.z - nearZ) ** 2 < LEVEL.playerRadius ** 2;
+}
+
+export function isInside(point) {
+  const bounds = WORKSHOP.inside;
+  return point.x > bounds.minX && point.x < bounds.maxX && point.z > bounds.minZ && point.z < bounds.maxZ;
+}
+
+export function isWalkable(state, x, z) {
+  const points = [{ x, z }, {
+    x: x + Math.sin(state.player.yaw) * LEVEL.playerForwardOffset,
+    z: z + Math.cos(state.player.yaw) * LEVEL.playerForwardOffset,
+  }];
+  const { bounds, playerRadius } = LEVEL;
+  const blockers = [...LEVEL.staticColliders, DOOR_COLLIDER];
+  if (state.shutterLift < WORKSHOP.clearance) blockers.push(WORKSHOP.doorway);
+  return points.every(point =>
+    point.x - playerRadius >= bounds.minX && point.x + playerRadius <= bounds.maxX
+    && point.z - playerRadius >= bounds.minZ && point.z + playerRadius <= bounds.maxZ
+    && !blockers.some(rect => overlaps(point, rect)));
+}
+
+function settle(next, previous, cost, milestone) {
+  const first = milestone && !previous.rewardedMilestones[milestone];
+  const reward = first ? LEVEL.progress.reward : 0;
+  const balance = previous.progress - cost + reward;
+  if (balance <= 0) {
+    const failed = cloneState(previous);
+    failed.progress = 0;
+    failed.minimumReserve = 0;
+    failed.failed = true;
+    failed.motion = "idle";
+    failed.lastEvent = "progress_depleted";
+    failed.interactions = next.interactions;
+    return failed;
+  }
+  next.progress = Math.min(LEVEL.progress.maximum, balance);
+  next.minimumReserve = Math.min(previous.minimumReserve, next.progress);
+  if (first) next.rewardedMilestones[milestone] = true;
+  return next;
+}
+
+export function updateMovement(state, input, deltaSeconds) {
+  if (state.complete || state.failed) return cloneState(state);
+  const next = cloneState(state);
+  const delta = Math.min(Math.max(deltaSeconds, 0), .05);
+  next.elapsed += delta;
+  const movement = applyRobotMovement(next, state, input, delta, LEVEL, isWalkable);
+  const distance = Math.hypot(next.player.x - state.player.x, next.player.z - state.player.z);
+  next.distanceMoved += distance;
+  next.motion = movement.motionTurning ? "turning" : distance > 1e-6 ? "moving" : "idle";
+  next.enteredWorkshop ||= state.shutterLift >= WORKSHOP.clearance && isInside(next.player);
+  const cost = distance * LEVEL.progress.perMeter
+    + (movement.translating && distance < 1e-6 && !movement.motionTurning ? LEVEL.progress.blockedPerSecond * delta : 0);
+  return settle(next, state, cost);
+}
+
+export function updateEnvironment(state, deltaSeconds) {
+  if (state.complete || state.failed || !state.shutterRequested) return cloneState(state);
+  const next = cloneState(state);
+  next.shutterLift = Math.min(WORKSHOP.height, state.shutterLift
+    + Math.min(Math.max(deltaSeconds, 0), .1) * WORKSHOP.height / WORKSHOP.openingSeconds);
+  return next;
+}
+
+function facing(state, target) {
+  const dx = target.x - state.player.x;
+  const dz = target.z - state.player.z;
+  const distance = Math.hypot(dx, dz);
+  return distance <= LEVEL.interactionRange && distance > .05
+    && (Math.sin(state.player.yaw) * dx + Math.cos(state.player.yaw) * dz) / distance > .35;
+}
+
+export function getInteraction(state) {
+  if (state.complete || state.failed) return null;
+  if (state.player.z > -1.3 && facing(state, WORKSHOP.doorControl)) {
+    return { type: "shutter", label: state.shutterRequested ? "卷帘门正在开启或已打开" : "打开厂房卷帘门" };
+  }
+  if (isInside(state.player) && facing(state, WORKSHOP.lightSwitch)) {
+    return { type: "lights", label: "开启厂房照明" };
+  }
+  return null;
+}
+
+export function interact(state) {
+  if (state.complete || state.failed) return cloneState(state);
+  const next = cloneState(state);
+  next.interactions += 1;
+  const interaction = getInteraction(state);
+  let milestone;
+  let cost = LEVEL.progress.error;
+  if (interaction?.type === "shutter" && !state.shutterRequested) {
+    next.shutterRequested = true;
+    next.lastEvent = "shutter_opening";
+    milestone = "shutter";
+    cost = 0;
+  } else if (interaction?.type === "lights" && state.enteredWorkshop && state.shutterLift >= WORKSHOP.clearance) {
+    next.lightsOn = true;
+    next.complete = true;
+    next.motion = "idle";
+    next.lastEvent = "workshop_lit";
+    milestone = "lights";
+    cost = 0;
+  } else {
+    next.lastEvent = interaction?.type === "shutter" ? "shutter_already_opening" : "empty_interaction";
+  }
+  return settle(next, state, cost, milestone);
+}
+
+export function closeTerminal(state) { return cloneState(state); }
+
+export function getObjective(state) {
+  if (state.failed) return { step: 0, title: "任务失败", detail: "余量耗尽，按 R 重置。" };
+  if (state.complete) return { step: 3, title: "厂房照明已开启", detail: "已进入厂房并操作室内照明开关。" };
+  if (!state.shutterRequested) return { step: 1, title: "打开厂房卷帘门", detail: "靠近门边控制按钮，面向按钮按 F。" };
+  if (!state.enteredWorkshop) return { step: 2, title: "进入黑暗厂房", detail: "等待卷帘门升起后进入。" };
+  return { step: 3, title: "打开室内照明", detail: "找到室内墙上的照明开关，面向开关按 F。" };
+}
