+import { ui as originalUi, camera } from "../rf01/runtime.js";
+import { LEVEL, WORKSHOP } from "./level.js";
+import { createFacilityScene, syncFacilityVisuals } from "../../scene.js";
+import { setWorkshopLighting, syncWorkshopShutter } from "../../rf01-workshop.js";
+export { LEVEL, camera };
+export { createInitialState, cloneState, updateMovement, updateEnvironment, interact, getInteraction, isWalkable, closeTerminal, getObjective } from "./engine.js";
+export const ui = Object.freeze({
+  ...originalUi, id: "rf01-2", brand: "INDUSTRIAL PARK / A01-2",
+  unit: "RF-01-2 · WORKSHOP LIGHTING", systemLabel: "厂房照明", gateLabel: "卷帘门",
+  startKicker: "RF-01-2 / WORKSHOP LIGHTING", startTitle: "厂房<br />照明恢复",
+  startCopy: "打开卷帘门，进入黑暗厂房并开启室内照明。",
+  completeTitle: "厂房照明已开启", completeCopy: "卷帘门已打开，机器人进入厂房并打开了室内照明。",
+});
+export const eventMessages = Object.freeze({
+  shutter_opening: "卷帘门正在升起，净空足够后可进入",
+  shutter_already_opening: "卷帘门已启动，无需重复操作 · 余量 -5",
+  workshop_lit: "厂房照明已开启，任务完成",
+  empty_interaction: "请靠近并面向开关 · 余量 -5",
+  progress_depleted: "任务余量耗尽，按 R 重置",
+});
+export const audio = Object.freeze({ assets: {}, eventSounds: {}, volume: {} });
+export function createScene() { return createFacilityScene(); }
+export function isCarrying() { return false; }
+export function syncVisuals(world, state, delta) {
+  syncFacilityVisuals(world, state, delta);
+  if (world.workshop) {
+    syncWorkshopShutter(world.workshop, state.shutterLift);
+    setWorkshopLighting(world.workshop, state.lightsOn);
+  }
+}
+export function getTelemetry(state) {
+  return { system: state.lightsOn ? "ON" : "OFF", systemOnline: state.lightsOn, cargo: "EMPTY",
+    gate: state.shutterLift >= WORKSHOP.clearance ? "OPEN" : state.shutterRequested ? "OPENING" : "CLOSED" };
+}
+export function getProgressSteps(state) {
+  return [
+    { label: "打开卷帘门", done: state.shutterLift >= WORKSHOP.clearance, active: !state.shutterRequested },
+    { label: "进入黑暗厂房", done: state.enteredWorkshop, active: state.shutterRequested && !state.enteredWorkshop },
+    { label: "开启室内照明", done: state.lightsOn, active: state.enteredWorkshop && !state.lightsOn },
+  ];
+}
+export function getTerminal() { return { title: "厂房照明", copy: ui.startCopy, rows: [] }; }
+export function getSoundPosition(_before, state) { return state.player; }
+export function getDebugState(state) {
+  return { revision: LEVEL.revision, shutterLift: state.shutterLift, enteredWorkshop: state.enteredWorkshop,
+    lightsOn: state.lightsOn, distanceMoved: state.distanceMoved, minimumReserve: state.minimumReserve };
+}
diff --git a/game/rf01-workshop.js b/game/rf01-workshop.js
new file mode 100644
--- /dev/null
+++ b/game/rf01-workshop.js
@@ -0,0 +1,226 @@
+import * as THREE from "three";
+import { WORKSHOP } from "./levels/rf01-2/level.js";
+
+function makeBox(parent, name, size, position, material) {
+  const mesh = new THREE.Mesh(new THREE.BoxGeometry(...size), material);
+  mesh.name = name;
+  mesh.position.set(...position);
+  mesh.castShadow = true;
+  mesh.receiveShadow = true;
+  parent.add(mesh);
+  return mesh;
+}
+
+function splitPolygon(polygon, axis, boundary, direction) {
+  const inside = [];
+  const outside = [];
+  for (let index = 0; index < polygon.length; index += 1) {
+    const current = polygon[index];
+    const next = polygon[(index + 1) % polygon.length];
+    const distance = (current.position[axis] - boundary) * direction;
+    const nextDistance = (next.position[axis] - boundary) * direction;
+    (distance >= 0 ? inside : outside).push(current);
+    if ((distance >= 0) !== (nextDistance >= 0)) {
+      const fraction = distance / (distance - nextDistance);
+      const vertex = {
+        position: current.position.clone().lerp(next.position, fraction),
+        normal: current.normal.clone().lerp(next.normal, fraction).normalize(),
+        uv: current.uv.clone().lerp(next.uv, fraction),
+      };
+      inside.push(vertex);
+      outside.push(vertex);
+    }
+  }
+  return { inside, outside };
+}
+
+export function separateShutter(source) {
+  source.updateWorldMatrix(true, false);
+  const geometry = source.geometry;
+  const positions = geometry.getAttribute("position");
+  const normals = geometry.getAttribute("normal");
+  const textureCoordinates = geometry.getAttribute("uv");
+  const normalMatrix = new THREE.Matrix3().getNormalMatrix(source.matrixWorld);
+  const vertices = Array.from({ length: positions.count }, (_, index) => ({
+    position: new THREE.Vector3().fromBufferAttribute(positions, index).applyMatrix4(source.matrixWorld),
+    normal: new THREE.Vector3().fromBufferAttribute(normals, index).applyMatrix3(normalMatrix).normalize(),
+    uv: new THREE.Vector2().fromBufferAttribute(textureCoordinates, index),
+  }));
+  const shellIndices = [];
+  const doorIndices = [];
+  const positionValues = vertices.flatMap(vertex => vertex.position.toArray());
+  const normalValues = vertices.flatMap(vertex => vertex.normal.toArray());
+  const uvValues = vertices.flatMap(vertex => vertex.uv.toArray());
+  vertices.forEach((vertex, index) => { vertex.index = index; });
+  const planes = [
+    ["x", WORKSHOP.doorway.minX, 1], ["x", WORKSHOP.doorway.maxX, -1],
+    ["y", .035, 1], ["y", WORKSHOP.height, -1],
+    ["z", -1.72, 1], ["z", -.96, -1],
+  ];
+  function appendPolygon(polygon, target) {
+    if (polygon.length < 3) return;
+    const indices = polygon.map(vertex => {
+      if (vertex.index === undefined) {
+        vertex.index = positionValues.length / 3;
+        positionValues.push(...vertex.position.toArray());
+        normalValues.push(...vertex.normal.toArray());
+        uvValues.push(...vertex.uv.toArray());
+      }
+      return vertex.index;
+    });
+    for (let index = 1; index < indices.length - 1; index += 1) target.push(indices[0], indices[index], indices[index + 1]);
+  }
+  const count = geometry.index?.count ?? positions.count;
+  for (let offset = 0; offset < count; offset += 3) {
+    const triangle = [0, 1, 2].map(step => vertices[geometry.index ? geometry.index.getX(offset + step) : offset + step]);
+    if (planes.some(([axis, boundary, direction]) => triangle.every(vertex => (vertex.position[axis] - boundary) * direction < 0))) {
+      appendPolygon(triangle, shellIndices);
+      continue;
+    }
+    let polygon = triangle;
+    for (const [axis, boundary, direction] of planes) {
+      const split = splitPolygon(polygon, axis, boundary, direction);
+      appendPolygon(split.outside, shellIndices);
+      polygon = split.inside;
+      if (polygon.length < 3) break;
+    }
+    appendPolygon(polygon, doorIndices);
+  }
+  if (doorIndices.length < 30) throw new Error("RF-01 workshop shutter could not be separated");
+  const attributes = {
+    position: new THREE.Float32BufferAttribute(positionValues, 3),
+    normal: new THREE.Float32BufferAttribute(normalValues, 3),
+    uv: new THREE.Float32BufferAttribute(uvValues, 2),
+  };
+  function meshFor(indices, name) {
+    const result = new THREE.BufferGeometry();
+    Object.entries(attributes).forEach(([key, value]) => result.setAttribute(key, value));
+    result.setIndex(indices);
+    result.computeBoundingBox();
+    result.computeBoundingSphere();
+    const mesh = new THREE.Mesh(result, source.material);
+    mesh.name = name;
+    mesh.castShadow = true;
+    mesh.receiveShadow = true;
+    return mesh;
+  }
+  return { shell: meshFor(shellIndices, "workshop-original-shell"), door: meshFor(doorIndices, "workshop-original-shutter") };
+}
+
+function roomMaterial(color, map) {
+  const material = new THREE.MeshStandardMaterial({ color, map, roughness: .9, metalness: .03, envMapIntensity: .015 });
+  material.onBeforeCompile = shader => {
+    shader.fragmentShader = shader.fragmentShader.replace("#include <lights_fragment_end>",
+      "#include <lights_fragment_end>\nreflectedLight.indirectDiffuse *= 0.025;");
+  };
+  material.customProgramCacheKey = () => "workshop-interior-ambient-v1";
+  return material;
+}
+
+function addControl(parent, name, position, label, emissive) {
+  const plate = new THREE.MeshStandardMaterial({ color: 0xc4c6ba, roughness: .5, metalness: .3, envMapIntensity: .02 });
+  const root = new THREE.Group();
+  root.name = name;
+  root.position.set(...position);
+  if (name === "workshop-light-switch") root.rotation.y = -Math.PI / 2;
+  parent.add(root);
+  makeBox(root, name + "-box", [.28, .42, .085], [0, 0, 0], plate);
+  const buttonMaterial = new THREE.MeshStandardMaterial({ color: 0x317845, emissive: 0x1d6638, emissiveIntensity: emissive, roughness: .4 });
+  const button = makeBox(root, name + "-button", [.12, .13, .04], [0, -.07, .06], buttonMaterial);
+  const canvas = document.createElement("canvas");
+  canvas.width = 256;
+  canvas.height = 80;
+  const context = canvas.getContext("2d");
+  context.fillStyle = "#e6e7d9";
+  context.fillRect(0, 0, 256, 80);
+  context.fillStyle = "#15251d";
+  context.font = "bold 35px sans-serif";
+  context.textAlign = "center";
+  context.fillText(label, 128, 53);
+  const labelMaterial = new THREE.MeshStandardMaterial({ map: new THREE.CanvasTexture(canvas), roughness: .7, emissive: 0x223322, emissiveIntensity: .2 });
+  makeBox(root, name + "-label", [.245, .08, .01], [0, .105, .049], labelMaterial);
+  return button;
+}
+
+export function installWorkshopInterior(world) {
+  const workshop = world.productionAssets.getObjectByName("rf01-cardinal-workshop-meter-fitted");
+  if (!workshop) throw new Error("RF-01 workshop production asset missing");
+  const root = new THREE.Group();
+  root.name = "rf01-shared-workshop-interior";
+  world.scene.add(root);
+  const shutter = new THREE.Group();
+  shutter.name = "rf01-workshop-rolling-shutter";
+  root.add(shutter);
+  const originals = [];
+  workshop.traverse(object => { if (object.isMesh) originals.push(object); });
+  for (const original of originals) {
+    const separated = separateShutter(original);
+    root.add(separated.shell);
+    shutter.add(separated.door);
+    original.visible = false;
+  }
+  const floorSource = world.scene.getObjectByName("rf01-surface-concrete");
+  const wallMaterial = roomMaterial(0x858e91);
+  const floorMaterial = roomMaterial(0x737975, floorSource?.material?.map ?? null);
+  makeBox(root, "workshop-floor", [9.8, .04, 5.45], [0, .015, -4.15], floorMaterial);
+  makeBox(root, "workshop-ceiling", [9.8, .08, 5.4], [0, 4.0, -4.15], wallMaterial);
+  makeBox(root, "workshop-back-lining", [9.8, 3.95, .08], [0, 2, -6.81], wallMaterial);
+  makeBox(root, "workshop-west-lining", [.08, 3.95, 5.4], [-4.91, 2, -4.15], wallMaterial);
+  makeBox(root, "workshop-east-lining", [.08, 3.95, 5.4], [4.91, 2, -4.15], wallMaterial);
+  makeBox(root, "workshop-front-left-lining", [1.83, 3.95, .08], [-3.965, 2, -1.43], wallMaterial);
+  makeBox(root, "workshop-front-right-lining", [3.86, 3.95, .08], [2.98, 2, -1.43], wallMaterial);
+  makeBox(root, "workshop-door-lintel-lining", [4.1, 1.18, .12], [-1, 3.38, -1.43], wallMaterial);
+  const steel = new THREE.MeshStandardMaterial({ color: 0x5e686a, metalness: .7, roughness: .45 });
+  [-3.10, 1.10].forEach(position => makeBox(root, "shutter-guide", [.10, 2.86, .28], [position, 1.43, -1.30], steel));
+  makeBox(root, "shutter-roller-housing", [4.34, .25, .32], [-1, 2.88, -1.30], steel);
+  const outsideButton = addControl(root, "workshop-door-control",
+    [WORKSHOP.doorControl.x, WORKSHOP.doorControl.y, WORKSHOP.doorControl.z], "OPEN", .7);
+  const insideButton = addControl(root, "workshop-light-switch",
+    [WORKSHOP.lightSwitch.x, WORKSHOP.lightSwitch.y, WORKSHOP.lightSwitch.z], "LIGHT", .8);
+  const fixtures = world.productionAssets.children.filter(child => {
+    let found = false;
+    child.traverse(object => { if (object.name === "rf01-cardinal-lightFixture") found = true; });
+    return found;
+  });
+  const bulbs = [];
+  const lights = [];
+  fixtures.forEach((fixture, index) => {
+    const position = WORKSHOP.lampPositions[index];
+    if (!position) return;
+    fixture.position.set(...position);
+    fixture.traverse(object => {
+      if (!object.isMesh) return;
+      object.material = object.material.clone();
+      object.material.emissiveIntensity = 0;
+    });
+    const glow = new THREE.MeshStandardMaterial({ color: 0xcdd5d2, emissive: 0xffeed3, emissiveIntensity: 0, roughness: .5 });
+    bulbs.push(glow);
+    makeBox(root, "workshop-light-diffuser-" + index, [1.5, .025, .12], [position[0], 3.65, position[2]], glow);
+    const light = new THREE.PointLight(0xffeedc, 0, 9, 2);
+    light.position.set(position[0], 3.4, position[2]);
+    light.castShadow = true;
+    light.shadow.mapSize.set(512, 512);
+    light.shadow.bias = -.001;
+    root.add(light);
+    lights.push(light);
+    makeBox(root, "workshop-light-bracket-" + index, [.05, .24, .05], [position[0], 3.86, position[2]], steel);
+  });
+  if (fixtures.length !== 3) throw new Error("RF-01 workshop requires all three existing light fixtures");
+  const result = { root, shutter, lights, bulbs, outsideButton, insideButton, fixtures, revision: "workshop-light-v1" };
+  setWorkshopLighting(result, false);
+  syncWorkshopShutter(result, 0);
+  return result;
+}
+
+export function syncWorkshopShutter(workshop, lift) {
+  const height = Math.max(0, Math.min(WORKSHOP.height, lift));
+  workshop.shutter.position.y = height;
+  workshop.shutter.scale.y = Math.max(.012, (WORKSHOP.height - height) / WORKSHOP.height);
+  workshop.outsideButton.material.emissiveIntensity = height >= WORKSHOP.clearance ? 1.3 : .45;
+}
+
+export function setWorkshopLighting(workshop, enabled) {
+  workshop.lights.forEach(light => { light.intensity = enabled ? 85 : 0; });
+  workshop.bulbs.forEach(material => { material.emissiveIntensity = enabled ? 5 : 0; });
+  workshop.insideButton.material.emissiveIntensity = enabled ? 1.3 : .8;
+}
