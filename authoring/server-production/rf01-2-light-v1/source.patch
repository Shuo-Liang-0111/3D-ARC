+import { LEVEL as PARK } from "../../level.js";
+import { RF01_COLLISION_PROXY_RECTS } from "../../rf01-collision-proxies.js";
+
+export const WORKSHOP = Object.freeze({
+  doorway: { minX: -3.05, maxX: 1.05, minZ: -1.58, maxZ: -1.12 },
+  height: 2.76,
+  clearance: 2.1,
+  openingSeconds: 3,
+  doorControl: { x: 1.38, y: 1.2, z: -1.08 },
+  lightSwitch: { x: 4.73, y: 1.2, z: -4.9 },
+  inside: { minX: -4.8, maxX: 4.8, minZ: -6.7, maxZ: -1.8 },
+  lampPositions: [[-3.2, 3.68, -4.3], [0, 3.68, -4.3], [3.2, 3.68, -4.3]],
+});
+
+export const LEVEL = Object.freeze({
+  ...PARK,
+  id: "rf01-2",
+  revision: "workshop-light-v1",
+  title: "进入厂房并开启照明",
+  interactionRange: 1.25,
+  staticColliders: Object.freeze([
+    ...PARK.staticColliders.filter(({ id }) => !["workshop", "fire-safety-station"].includes(id)),
+    ...RF01_COLLISION_PROXY_RECTS.filter(({ id }) => !["workshop-front-door", "workshop-interior"].includes(id)),
+    { id: "workshop-jamb-left", minX: -3.2, maxX: -3.05, minZ: -1.65, maxZ: -1.08 },
+    { id: "workshop-jamb-right", minX: 1.05, maxX: 1.22, minZ: -1.65, maxZ: -1.08 },
+    { id: "workshop-crate-left", minX: -4.85, maxX: -3.75, minZ: -2, maxZ: -1 },
+    { id: "workshop-crate-right", minX: -3.45, maxX: -2.4, minZ: -2, maxZ: -1 },
+  ]),
+  progress: Object.freeze({ initial: 100, maximum: 100, perMeter: 3.6, blockedPerSecond: 2, error: 5, reward: 3 }),
+});
