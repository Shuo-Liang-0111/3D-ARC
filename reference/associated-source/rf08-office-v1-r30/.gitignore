# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnpm-store/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# repository-local runtimes and backups
/.tooling/
/.backups/

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
._*
*.orig
*.pem
/.idea/
/.vscode/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
/data/

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/

# local server process files
/http.log
/http.pid

# Local Cardinal-generated assets (never publish generated files or credentials)
/public/local-assets/cardinal/

# Native Godot editor cache, exports and local generated assets
/native/.godot/
/native/builds/
/native/local_assets/
/native/tools/node_modules/

# Generated and binary 3D assets stay on the production server
/public/local-assets/embodiedgen/
/public/local-assets/polyhaven/
*.glb
*.gltf
*.fbx
*.blend
*.obj
*.ply
*.stl
*.usd
*.usda
*.usdc
*.urdf

/public/office-scan/

# Local secrets
/secrets/
*.key
